{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Krint": {
    "Role": "control"
  },
  "Oidc": {
    // KRINT has always accepted whatever audience the IdP stamps on the token. Keycloak's default
    // access token names "account" rather than the client id, so switching this on needs an audience
    // mapper on the IdP (or Oidc:ValidAudiences here) first. Deliberately left as it was.
    "ValidateAudience": false,
    // Browsers cannot set an Authorization header on a WebSocket handshake, so the SignalR hubs read
    // the token from ?access_token=. /hubs/node carries a pre-shared node token instead and
    // authenticates inside the hub, so it is carved back out.
    "QueryToken": {
      "IncludePaths": [ "/hubs" ],
      "ExcludePaths": [ "/hubs/node" ]
    }
  },
  "Node": {
    "Tokens": [],
    "ControlPlaneUrl": "",
    "Token": "",
    "Id": "",
    "Name": ""
  }
}
