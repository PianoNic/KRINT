# Optional overrides for the clone-and-run stack in compose.yml. Copy to .env to change anything;
# without this file the stack boots Postgres and KRINT on http://localhost:56722 with local password
# login (user "admin"; the generated password is printed once in `docker logs krint`).
#
# For a real deployment follow docs/self-host.md and point KRINT at your own identity provider.

# Master key that encrypts every stored database password (AES-256). Leave it unset and KRINT
# generates one on first boot into ./data/vault.key - back that file up. To manage it yourself,
# generate one with `openssl rand -base64 32` and never change it once you have data.
# A stack started before keys were generated used the old public demo key; if boot fails with
# "does not match stored secrets", set Vault__MasterKey=2P+vvGUw5v3weZdFU04YOicpVNs9eIyRKo6NliiDR4c=
# here to read that data.
# Vault__MasterKey=

# Local login settings (only when no Oidc__Authority is set).
# LocalLogin__AdminUserName=admin
# LocalLogin__AdminPassword=          # leave unset to get a generated one in the log
# LocalLogin__LogIssuedCredentials=false   # true logs reset tokens and admin-issued passwords

# Your own OIDC provider instead of local login. Authority must match the issuer in
# <authority>/.well-known/openid-configuration byte for byte.
# Oidc__Authority=https://auth.example.com/realms/krint
# Oidc__ClientId=krint
# Oidc__RoleClaim=roles
# Oidc__AdminRole=krint-admin
# Oidc__RequireAdminRoleGlobally=true

# Public URL KRINT is reached on. Drives the login redirect, CORS and the Add-node compose.
# Krint__PublicUrl=https://krint.example.com
# Cors__AllowedOrigins__0=https://krint.example.com
